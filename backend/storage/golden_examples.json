        "question": "Show system summary for today",
        "type": "mql",
        "content": "{ \"collection\": \"systemDailySummaryInfo\", \"query\": [ { \"$sort\": { \"date\": -1 } }, { \"$limit\": 1 }, { \"$project\": { \"_id\": 0, \"totalActiveDevicesCount\": 1, \"totalDevicesAdded\": 1, \"totalTransactionsCount\": 1, \"totalTransactionAmount\": 1 } } ] }"
    },
